{
  "name": "noor-browser",
  "productName": "Noor",
  "version": "1.0.0",
  "description": "A private browser for Windows: profiles with their own fingerprints and data, tracker blocking and HTTPS upgrades, like the Noor app for iPhone.",
  "main": "main/main.js",
  "license": "MIT",
  "author": "kamaltv1010-boop",
  "repository": "github:kamaltv1010-boop/noor-windows",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win --x64 --publish never",
    "start:iphone": "electron . --noor-iphone",
    "dist:iphone": "node tools/build-iphone.js"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ma.noor.browser",
    "productName": "Noor",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "scripts/**/*",
      "rules/**/*",
      "build/icon.*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Noor",
      "artifactName": "Noor-Setup-${version}-windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Noor-${version}-windows-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-chrome-extensions": "^4.10.0"
  }
}
